+# SPDX-License-Identifier: Apache-2.0
+
+from types import SimpleNamespace
+from unittest.mock import MagicMock, patch
+
+import pytest
+import torch
+from transformers import Mistral4Config
+from transformers.models.pixtral import PixtralProcessor
+from transformers.models.mistral4.modeling_mistral4 import (
+    Mistral4RotaryEmbedding,
+)
+
+from vllm.config import VllmConfig, set_current_vllm_config
+from vllm.model_executor.layers.rotary_embedding import get_rope
+from vllm.model_executor.models.mistral3 import Mistral3ProcessingInfo
+from vllm.model_executor.models.mistral4 import (
+    prepare_mistral4_config,
+    unpack_mistral4_expert_weights,
+)
+from vllm.tokenizers.mistral import MistralTokenizer
+
+
+def test_mistral4_processor_uses_checkpoint_hf_tokenizer() -> None:
+    tokenizer = object.__new__(MistralTokenizer)
+    tokenizer.version = 15
+    hf_tokenizer = object()
+    model_config = MagicMock()
+    ctx = MagicMock(model_config=model_config)
+    ctx.get_tokenizer.return_value = tokenizer
+    ctx.get_merged_mm_kwargs.return_value = {
+        "size": {"longest_edge": 1540},
+        "tokenizer": hf_tokenizer,
+    }
+    expected_processor = MagicMock()
+
+    with patch(
+        "vllm.model_executor.models.mistral3.cached_processor_from_config",
+        return_value=expected_processor,
+    ) as get_processor:
+        processor = Mistral3ProcessingInfo(ctx).get_hf_processor()
+
+    assert processor is expected_processor
+    get_processor.assert_called_once_with(
+        model_config,
+        processor_cls=PixtralProcessor,
+        size={"longest_edge": 1540},
+    )
+
+
+def test_prepare_mistral4_config() -> None:
+    original_rope_parameters = {
+        "rope_type": "yarn",
+        "original_max_position_embeddings": 8192,
+        "llama_4_scaling_beta": 0.1,
+        "attention_factor": 1.25,
+        "partial_rotary_factor": 0.5,
+    }
+    text_config = SimpleNamespace(rope_parameters=original_rope_parameters)
+    vllm_config = SimpleNamespace(
+        model_config=SimpleNamespace(hf_config=text_config)
+    )
+
+    prepare_mistral4_config(vllm_config)
+
+    assert text_config.llama_4_scaling == {
+        "original_max_position_embeddings": 8192,
+        "beta": 0.1,
+    }
+    assert text_config.rope_parameters["apply_yarn_scaling"] is False
+    assert text_config.rope_parameters["attn_factor"] == 1.25
+    assert text_config.rope_parameters["partial_rotary_factor"] == 1.0
+    assert "apply_yarn_scaling" not in original_rope_parameters
+    assert original_rope_parameters["partial_rotary_factor"] == 0.5
+
+
+@pytest.mark.parametrize(
+    ("config_overrides", "error_match"),
+    [
+        ({"rope_interleave": False}, "rope_interleave=True"),
+        ({"n_group": 2, "topk_group": 1}, "grouped expert routing"),
+    ],
+)
+def test_prepare_mistral4_config_rejects_unsupported_semantics(
+    config_overrides: dict[str, object], error_match: str
+) -> None:
+    text_config = SimpleNamespace(
+        rope_parameters={
+            "rope_type": "yarn",
+            "original_max_position_embeddings": 8192,
+            "llama_4_scaling_beta": 0.1,
+        },
+        **config_overrides,
+    )
+    vllm_config = SimpleNamespace(
+        model_config=SimpleNamespace(hf_config=text_config)
+    )
+
+    with pytest.raises(NotImplementedError, match=error_match):
+        prepare_mistral4_config(vllm_config)
+
+
+def test_prepared_rope_matches_transformers_rotary_dimensions() -> None:
+    config = Mistral4Config(
+        max_position_embeddings=64,
+        rope_parameters={
+            "rope_type": "yarn",
+            "factor": 2.0,
+            "rope_theta": 10000.0,
+            "original_max_position_embeddings": 32,
+            "beta_fast": 32.0,
+            "beta_slow": 1.0,
+            "mscale": 1.0,
+            "mscale_all_dim": 1.0,
+            "llama_4_scaling_beta": 0.1,
+        },
+    )
+    hf_rope = Mistral4RotaryEmbedding(config)
+    positions = torch.arange(64).unsqueeze(0)
+    hf_cos, hf_sin = hf_rope(
+        torch.empty(1, 64, config.qk_rope_head_dim), positions
+    )
+
+    prepare_mistral4_config(
+        SimpleNamespace(model_config=SimpleNamespace(hf_config=config))
+    )
+    config.rope_parameters["rope_type"] = "deepseek_llama_scaling"
+    with set_current_vllm_config(VllmConfig()):
+        vllm_rope = get_rope(
+            config.qk_rope_head_dim,
+            max_position=config.max_position_embeddings,
+            is_neox_style=False,
+            rope_parameters=config.rope_parameters,
+            dtype=torch.float32,
+        )
+    vllm_cos, vllm_sin = vllm_rope.get_cos_sin(64)
+
+    assert vllm_rope.rotary_dim == config.qk_rope_head_dim
+    torch.testing.assert_close(vllm_cos, hf_cos[0, :, :32])
+    torch.testing.assert_close(vllm_sin, hf_sin[0, :, :32])
+
+
+def test_unpack_mistral4_expert_weights() -> None:
+    gate_up = torch.arange(2 * 6 * 4).reshape(2, 6, 4)
+    down = torch.arange(2 * 4 * 3).reshape(2, 4, 3)
+    other = torch.ones(2)
+
+    unpacked = dict(
+        unpack_mistral4_expert_weights(
+            [
+                ("layers.0.mlp.experts.gate_up_proj", gate_up),
+                ("layers.0.mlp.experts.down_proj", down),
+                ("layers.0.input_layernorm.weight", other),
+            ],
+            num_experts=2,
+        )
+    )
+
+    assert len(unpacked) == 7
+    torch.testing.assert_close(
+        unpacked["layers.0.mlp.experts.0.gate_proj.weight"], gate_up[0, :3]
+    )
+    torch.testing.assert_close(
+        unpacked["layers.0.mlp.experts.1.up_proj.weight"], gate_up[1, 3:]
+    )
+    torch.testing.assert_close(
+        unpacked["layers.0.mlp.experts.1.down_proj.weight"], down[1]
+    )
+    assert unpacked["layers.0.input_layernorm.weight"] is other
