new file mode 100644
index 0000000000..7859d1f53b
--- /dev/null
+++ b/vllm/model_executor/models/mistral4.py
@@ -0,0 +1,122 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+"""Inference-only Mistral 4 language model."""
+
+from collections.abc import Iterable, Iterator
+
+import torch
+
+from vllm.config import VllmConfig
+
+from .deepseek_v2 import DeepseekV2ForCausalLM, DeepseekV2Model
+
+
+def prepare_mistral4_config(vllm_config: VllmConfig) -> None:
+    """Map Mistral 4 config fields onto the shared MLA implementation."""
+    config = vllm_config.model_config.hf_config
+
+    if not getattr(config, "rope_interleave", True):
+        raise NotImplementedError(
+            "Mistral 4 currently requires rope_interleave=True in vLLM."
+        )
+    if getattr(config, "n_group", 1) != 1 or getattr(config, "topk_group", 1) != 1:
+        raise NotImplementedError(
+            "Mistral 4 grouped expert routing with n_group/topk_group other "
+            "than 1 is not yet supported."
+        )
+
+    rope_parameters = dict(config.rope_parameters)
+    config.rope_parameters = rope_parameters
+
+    # Transformers' Mistral 4 YaRN implementation applies the mscale ratio to
+    # RoPE but does not apply DeepSeek's additional mscale_all_dim**2 factor to
+    # the attention scale. The shared MLA implementation uses this flag to
+    # distinguish those two policies.
+    rope_parameters["apply_yarn_scaling"] = False
+
+    # Mistral4Config expresses its 64 rotary dimensions as half of the full
+    # 128-dimensional QK head. The shared MLA layer already passes the 64-dim
+    # qk_rope_head_dim to get_rope(), so retaining the original 0.5 factor
+    # would incorrectly rotate only 32 dimensions.
+    rope_parameters["partial_rotary_factor"] = 1.0
+    if "attention_factor" in rope_parameters:
+        rope_parameters["attn_factor"] = rope_parameters["attention_factor"]
+
+    if not hasattr(config, "llama_4_scaling"):
+        config.llama_4_scaling = {
+            "original_max_position_embeddings": rope_parameters[
+                "original_max_position_embeddings"
+            ],
+            "beta": rope_parameters["llama_4_scaling_beta"],
+        }
+
+
+def unpack_mistral4_expert_weights(
+    weights: Iterable[tuple[str, torch.Tensor]],
+    num_experts: int,
+) -> Iterator[tuple[str, torch.Tensor]]:
+    """Expand Mistral's packed expert tensors for the shared MoE loader."""
+    gate_up_suffix = ".experts.gate_up_proj"
+    down_suffix = ".experts.down_proj"
+
+    for name, loaded_weight in weights:
+        if name.endswith(gate_up_suffix):
+            if loaded_weight.ndim != 3 or loaded_weight.shape[0] != num_experts:
+                raise ValueError(
+                    "Unexpected packed Mistral 4 gate/up expert shape: "
+                    f"name={name}, shape={tuple(loaded_weight.shape)}, "
+                    f"num_experts={num_experts}"
+                )
+            if loaded_weight.shape[1] % 2:
+                raise ValueError(
+                    "Mistral 4 packed gate/up dimension must be even: "
+                    f"name={name}, shape={tuple(loaded_weight.shape)}"
+                )
+
+            prefix = name[: -len(gate_up_suffix)]
+            gate_weights, up_weights = loaded_weight.chunk(2, dim=1)
+            for expert_id in range(num_experts):
+                expert_prefix = f"{prefix}.experts.{expert_id}"
+                yield f"{expert_prefix}.gate_proj.weight", gate_weights[expert_id]
+                yield f"{expert_prefix}.up_proj.weight", up_weights[expert_id]
+            continue
+
+        if name.endswith(down_suffix):
+            if loaded_weight.ndim != 3 or loaded_weight.shape[0] != num_experts:
+                raise ValueError(
+                    "Unexpected packed Mistral 4 down expert shape: "
+                    f"name={name}, shape={tuple(loaded_weight.shape)}, "
+                    f"num_experts={num_experts}"
+                )
+
+            prefix = name[: -len(down_suffix)]
+            for expert_id in range(num_experts):
+                yield (
+                    f"{prefix}.experts.{expert_id}.down_proj.weight",
+                    loaded_weight[expert_id],
+                )
+            continue
+
+        yield name, loaded_weight
+
+
+class Mistral4Model(DeepseekV2Model):
+    def __init__(self, *, vllm_config: VllmConfig, prefix: str = "") -> None:
+        prepare_mistral4_config(vllm_config)
+        super().__init__(vllm_config=vllm_config, prefix=prefix)
+
+    def load_weights(self, weights: Iterable[tuple[str, torch.Tensor]]) -> set[str]:
+        weights = unpack_mistral4_expert_weights(
+            weights,
+            num_experts=self.config.n_routed_experts,
+        )
+        return super().load_weights(weights)
+
+
+class Mistral4ForCausalLM(DeepseekV2ForCausalLM):
+    model_cls = Mistral4Model
+
+    def __init__(self, *, vllm_config: VllmConfig, prefix: str = "") -> None:
+        prepare_mistral4_config(vllm_config)
+        super().__init__(vllm_config=vllm_config, prefix=prefix)
